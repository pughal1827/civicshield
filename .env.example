# ================================================================
# CIVICSHIELD AI - ENVIRONMENT CONFIGURATION
# ================================================================

# Storage Mode: 'supabase' to connect live PostgreSQL database, or 'mock' for local persistent JSON store
CIVICSHIELD_MODE=production
CIVICSHIELD_STORAGE_MODE=supabase

# --- SUPABASE DATABASE CONFIGURATION ---
# 1. Create a free project at https://supabase.com
# 2. Get these credentials from: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- GEMINI AI API KEY (Optional for live classification) ---
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
